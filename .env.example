# ===== 服务端口 =====
PORT=3000

# ===== CodeBuddy 凭证（三选一即可）=====
# 方式一：API Key（推荐用于服务器部署），从 https://www.codebuddy.cn 获取
CODEBUDDY_API_KEY=your_api_key_here

# 方式二：Auth Token（可选）
# CODEBUDDY_AUTH_TOKEN=your_auth_token_here

# 接入环境：external（公网） / internal（内网），默认 external
CODEBUDDY_INTERNET_ENVIRONMENT=external

# 私有化网关地址（可选，仅自建网关需要）
# CODEBUDDY_BASE_URL=https://your-gateway.example.com

# ===== 默认行为（可选）=====
# 新建会话默认工作目录：Agent 将在此目录读写代码。
# 建议在服务器上指向你的代码仓库，例如 /srv/repos
DEFAULT_CWD=/srv/repos

# 默认权限模式：default | acceptEdits | plan | bypassPermissions
#   default       每次工具调用都需确认
#   acceptEdits   自动接受文件编辑，命令类操作仍需确认（推荐）
#   plan          只读计划模式（不修改文件）
#   bypassPermissions  完全自动（仅限可信环境）
DEFAULT_PERMISSION_MODE=acceptEdits

# 单次请求最大工具轮数
MAX_TURNS=20

# 默认系统提示词（留空则用内置的"专业编码助手"提示词）
# DEFAULT_SYSTEM_PROMPT=
