# ===== 服务端口 =====
PORT=3000

# ===== 模型凭证（OpenAI 兼容）=====
# 你的模型 API Key（必填）
OPENAI_API_KEY=your_api_key_here

# API 基址：OpenAI 官方留空即可；自建/第三方兼容网关填其地址，例如：
#   DeepSeek:  https://api.deepseek.com/v1
#   本地 Ollama: http://localhost:11434/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Azure OpenAI: https://<resource>.openai.azure.com/openai
OPENAI_BASE_URL=

# 默认模型（必填，决定聊天使用的模型）
OPENAI_MODEL=gpt-4o

# 可选：额外可选项模型列表（逗号分隔，前端下拉框会显示；第一项以外的备选）
OPENAI_MODELS=

# ===== 默认行为（可选）=====
# 新建会话默认工作目录：Agent 将在此目录读写代码。
# 建议在服务器上指向你的代码仓库，例如 /srv/repos
DEFAULT_CWD=/srv/repos

# 默认权限模式：default | acceptEdits | plan | bypassPermissions
#   default       写文件/执行命令前均需确认
#   acceptEdits   自动接受文件编辑，命令类操作仍需确认（推荐）
#   plan          只读计划模式（不修改文件）
#   bypassPermissions  完全自动（仅限可信环境）
DEFAULT_PERMISSION_MODE=acceptEdits

# 单次请求最大工具轮数
MAX_TURNS=20

# 单次请求带入模型的历史消息条数上限（防止长会话把上下文打满）
MAX_HISTORY_MESSAGES=20

# 默认系统提示词（留空则用内置的"办公助手"提示词）
# DEFAULT_SYSTEM_PROMPT=

# ===== 认证（Phase 1 新增）=====
# JWT 签名密钥。
#   生产环境（NODE_ENV=production）【必须】填写，否则服务拒绝启动。
#   开发环境留空即可：会自动生成随机密钥并存到 data/.jwt-secret。
# 生成命令：  openssl rand -base64 48
JWT_SECRET=

# 访问令牌有效期（默认 24h）；登录与 /api/auth/refresh 均按此签发。
# JWT_EXPIRES_IN=24h

# ===== WebSocket =====
# 允许连接 WS 的前端源（逗号分隔），例如 https://office.example.com
# 生产环境务必填写；留空表示不限制来源（仅适合本地开发）。
WS_ORIGIN=

# ===== 默认管理员（首次启动自动创建）=====
# 首次启动若库中无用户，会自动创建该管理员账号。
# 生产环境【必须】设置 DEFAULT_ADMIN_PASSWORD，否则服务拒绝启动。
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=
