# ===== 服务端口 =====
PORT=3000

# ===== 模型凭证（OpenAI 兼容）=====
# 你的模型 API Key（必填）
OPENAI_API_KEY=your_api_key_here

# API 基址：OpenAI 官方留空即可；自建/第三方兼容网关填其地址，例如：
#   DeepSeek:  https://api.deepseek.com/v1
#   本地 Ollama: http://localhost:11434/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Azure OpenAI: https://<resource>.openai.azure.com/openai
OPENAI_BASE_URL=

# 默认模型（必填，决定聊天使用的模型）
OPENAI_MODEL=gpt-4o

# 可选：额外可选项模型列表（逗号分隔，前端下拉框会显示；第一项以外的备选）
# OPENAI_MODELS=gpt-4o,gpt-4o-mini,deepseek-chat

# ===== 默认行为（可选）=====
# 新建会话默认工作目录：Agent 将在此目录读写代码。
# 建议在服务器上指向你的代码仓库，例如 /srv/repos
DEFAULT_CWD=/srv/repos

# 默认权限模式：default | acceptEdits | plan | bypassPermissions
#   default       写文件/执行命令前均需确认
#   acceptEdits   自动接受文件编辑，命令类操作仍需确认（推荐）
#   plan          只读计划模式（不修改文件）
#   bypassPermissions  完全自动（仅限可信环境）
DEFAULT_PERMISSION_MODE=acceptEdits

# 单次请求最大工具轮数
MAX_TURNS=20

# 默认系统提示词（留空则用内置的"专业编码助手"提示词）
# DEFAULT_SYSTEM_PROMPT=
