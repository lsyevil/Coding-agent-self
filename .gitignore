# 依赖
node_modules

# 构建产物
dist

# 运行时数据（SQLite 会话/消息库，可能含敏感内容）
data

# 环境变量（含密钥，切勿提交）
.env
.env.local

# 日志
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# 编辑器/IDE
.vscode
.idea
*.swp

# Vite 缓存
.vite

# tsc -b 生成的编译产物（server 由 tsx 直接运行 .ts，无需产物）
*.tsbuildinfo
server/**/*.js
server/**/*.d.ts
vite.config.js
vite.config.d.ts
